# URL pública do site. Usada em metadata, canonical, sitemap e JSON-LD.
# Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://rvland.com.br

# ID do Meta Pixel. Deixe vazio para não carregar o pixel.
# Atenção (LGPD): hoje o pixel dispara PageView sem camada de consentimento.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Plataforma (painel interno) ────────────────────────────────────────────
# Projeto Supabase: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (NUNCA expor no cliente): Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres (Settings > Database > Connection string, modo
# "Transaction pooler" na Vercel). Usada por Drizzle, migrations e seed.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo do cron da Vercel (Settings > Environment Variables; a Vercel envia
# como Authorization: Bearer <valor> nas chamadas agendadas).
CRON_SECRET=

# Usados apenas por `npm run db:seed` para criar o primeiro usuário (grupo Dono)
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
SEED_ADMIN_NOME=

# ── Hermes (licenciamento; rotas /api/agente/hermes e /api/hermes/*) ───────
# Par Ed25519 do documento de licença (kid h1). Gere com `npx tsx
# scripts/gerar-chaves.ts` (valor vazio = o script gera; chave com valor nunca é
# sobrescrita); a SK vai na Vercel, a PK vai no container/agente.
RVLAND_HERMES_SK=
RVLAND_HERMES_PK=
# Credencial de pull do GHCR entregue ao agente (rota .../hermes/credencial).
# Opcionais: HERMES_REGISTRO_REPOSITORIO (padrão ghcr.io/rvland-devs/hermes) e
# HERMES_REGISTRO_EXPIRA_EM (ISO; padrão agora + 1 h).
HERMES_REGISTRO_USUARIO=
HERMES_REGISTRO_TOKEN=
