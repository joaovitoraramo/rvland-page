# URL pública do site. Usada em metadata, canonical, sitemap e JSON-LD.
# Sem barra no final.
NEXT_PUBLIC_SITE_URL=https://rvland-page.vercel.app

# ID do Meta Pixel. Deixe vazio para não carregar o pixel.
# Atenção (LGPD): hoje o pixel dispara PageView sem camada de consentimento.
NEXT_PUBLIC_META_PIXEL_ID=

# ── Plataforma (painel interno) ────────────────────────────────────────────
# Projeto Supabase: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (NUNCA expor no cliente): Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Conexão direta ao Postgres (Settings > Database > Connection string, modo
# "Transaction pooler" na Vercel). Usada por Drizzle, migrations e seed.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo do cron da Vercel (Settings > Environment Variables; a Vercel envia
# como Authorization: Bearer <valor> nas chamadas agendadas).
CRON_SECRET=

# Usados apenas por `npm run db:seed` para criar o primeiro usuário (grupo Dono)
SEED_ADMIN_EMAIL=
SEED_ADMIN_SENHA=
SEED_ADMIN_NOME=
